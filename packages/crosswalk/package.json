{
  "name": "@haremantra/crosswalk",
  "version": "0.10.0",
  "description": "OWASP Agentic AI (ASI) ↔ NIST SP 800-53 Rev 5 ↔ NIST AI-RMF (AI 100-1) reference crosswalk data.",
  "license": "MIT",
  "author": "Shantanu Singh <shantsingh1976@gmail.com> (Obviate AI)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsx build/emit-artifacts.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "owasp",
    "agentic-ai",
    "nist-800-53",
    "ai-rmf",
    "compliance",
    "crosswalk",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haremantra/OWASP-AGENTIC-to-NIST-800-53v5-to-AI-RMF.git",
    "directory": "packages/crosswalk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./data.json": "./dist/crosswalk.json"
    }
  }
}
